<?xml version="1.0" encoding="UTF-8"?>
<definitions
        name="FileObjectService"
        targetNamespace="http://example.com/fileobject"
        xmlns="http://schemas.xmlsoap.org/wsdl/"
        xmlns:tns="http://example.com/fileobject"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">
    <types>
        <xsd:schema targetNamespace="http://example.com/fileobject"
                    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                    xmlns:tns="http://example.com/fileobject">

            <!-- ====================================================== -->
            <!--                     COMMON REQUEST TYPES                -->
            <!-- ====================================================== -->

            <!-- RequestHeader -->
            <xsd:complexType name="RequestHeader">
                <xsd:sequence>
                    <xsd:element name="ApplicationId" type="xsd:string"/>
                    <xsd:element name="ActorId" type="xsd:string"/>
                    <xsd:element name="FileObjectId" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- WsRequestBase -->
            <xsd:complexType name="WsRequestBase">
                <xsd:sequence>
                    <xsd:element name="header" type="tns:RequestHeader"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- ====================================================== -->
            <!--                    COMMON RESPONSE TYPES                -->
            <!-- ====================================================== -->

            <!-- ResponseHeader -->
            <xsd:complexType name="ResponseHeader">
                <xsd:sequence>
                    <xsd:element name="success" type="xsd:boolean"/>
                    <xsd:element name="errorCode" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="errorMessage" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- WsResponseBase -->
            <xsd:complexType name="WsResponseBase">
                <xsd:sequence>
                    <xsd:element name="header" type="tns:ResponseHeader"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- ====================================================== -->
            <!--                     COMMON OBJECT TYPES                 -->
            <!-- ====================================================== -->

            <!-- FileObjectBasicInfo -->
            <xsd:complexType name="FileObjectBasicInfo">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:string"/>
                    <xsd:element name="type" type="tns:FileObjectTypeEnumType"/>
                    <xsd:element name="status" type="tns:FileObjectStatusEnumType"/>
                    <xsd:element name="creationDateTime" type="xsd:dateTime"/>
                    <xsd:element name="modificationDateTime" type="xsd:dateTime"/>
                    <xsd:element name="permissions" type="tns:PermissionList"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- FileObjectDetailsInfo -->
            <xsd:complexType name="FileObjectDetailsInfo">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:string"/>
                    <xsd:element name="type" type="tns:FileObjectTypeEnumType"/>
                    <xsd:element name="name" type="xsd:string"/>
                    <xsd:element name="status" type="tns:FileObjectStatusEnumType"/>
                    <xsd:element name="creationDateTime" type="xsd:string"/>
                    <xsd:element name="modificationDateTime" type="xsd:string"/>
                    <xsd:element name="deletionDateTime" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="permissions" type="tns:PermissionList"/>
                    <xsd:element name="path">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="node" type="tns:FileObjectBasicInfo" minOccurs="0" maxOccurs="unbounded"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>

            <!-- ====================================================== -->
            <!--                     REQUEST BODY TYPES                  -->
            <!-- ====================================================== -->

            <xsd:complexType name="CreateDirRequestBody">
                <xsd:sequence>
                    <xsd:element name="name" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="CreateFileRequestBody">
                <xsd:sequence>
                    <xsd:element name="name" type="xsd:string"/>
                    <xsd:element name="contentReference" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="RenameFileObjectRequestBody">
                <xsd:sequence>
                    <xsd:element name="name" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="MoveFileObjectRequestBody">
                <xsd:sequence>
                    <xsd:element name="targetId" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="DeleteFileObjectRequestBody">
                <xsd:sequence/>
            </xsd:complexType>

            <xsd:complexType name="GetFileObjectDetailsRequestBody">
                <xsd:sequence/>
            </xsd:complexType>

            <xsd:complexType name="SearchFileObjectsRequestBody">
                <xsd:sequence>
                    <xsd:element name="pageIndex" type="xsd:int"/>
                    <xsd:element name="pageSize" type="xsd:int"/>
                    <xsd:element name="filters">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="filter" type="tns:SearchFilterType" minOccurs="0" maxOccurs="unbounded"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="sort">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="sort" type="tns:SortParameterType" minOccurs="0" maxOccurs="unbounded"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="SearchFilterType">
                <xsd:sequence>
                    <xsd:element name="field" type="tns:FilterFieldEnumType"/>
                    <xsd:element name="value" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="SortParameterType">
                <xsd:sequence>
                    <xsd:element name="field" type="tns:FilterFieldEnumType"/>
                    <xsd:element name="ascending" type="xsd:boolean"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- ====================================================== -->
            <!--                    RESPONSE BODY TYPES                  -->
            <!-- ====================================================== -->

            <xsd:complexType name="CreateDirResponseBody">
                <xsd:sequence>
                    <xsd:element name="fileObjectBasicInfo" type="tns:FileObjectBasicInfo"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="CreateFileResponseBody">
                <xsd:sequence>
                    <xsd:element name="fileObjectBasicInfo" type="tns:FileObjectBasicInfo"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="RenameFileObjectResponseBody">
                <xsd:sequence>
                    <xsd:element name="fileObjectBasicInfo" type="tns:FileObjectBasicInfo"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="MoveFileObjectResponseBody">
                <xsd:sequence>
                    <xsd:element name="fileObjectBasicInfo" type="tns:FileObjectBasicInfo"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="DeleteFileObjectResponseBody">
                <xsd:sequence/>
            </xsd:complexType>

            <xsd:complexType name="GetFileObjectDetailsResponseBody">
                <xsd:sequence>
                    <xsd:element name="fileObjectDetailsInfo" type="tns:FileObjectDetailsInfo"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="SearchFileObjectsResponseBody">
                <xsd:sequence>
                    <xsd:element name="totalCount" type="xsd:int"/>
                    <xsd:element name="items" type="tns:FileObjectBasicInfo" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- ====================================================== -->
            <!--                     REQUEST TYPES                       -->
            <!-- ====================================================== -->

            <xsd:complexType name="CreateDirRequestType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsRequestBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:CreateDirRequestBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="CreateFileRequestType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsRequestBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:CreateFileRequestBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="RenameFileObjectRequestType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsRequestBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:RenameFileObjectRequestBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="MoveFileObjectRequestType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsRequestBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:MoveFileObjectRequestBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="DeleteFileObjectRequestType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsRequestBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:DeleteFileObjectRequestBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="GetFileObjectDetailsRequestType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsRequestBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:GetFileObjectDetailsRequestBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="SearchFileObjectsRequestType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsRequestBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:SearchFileObjectsRequestBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <!-- ====================================================== -->
            <!--                     RESPONSE TYPES                      -->
            <!-- ====================================================== -->

            <xsd:complexType name="CreateDirResponseType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsResponseBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:CreateDirResponseBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="CreateFileResponseType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsResponseBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:CreateFileResponseBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="RenameFileObjectResponseType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsResponseBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:RenameFileObjectResponseBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="MoveFileObjectResponseType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsResponseBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:MoveFileObjectResponseBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="DeleteFileObjectResponseType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsResponseBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:DeleteFileObjectResponseBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="GetFileObjectDetailsResponseType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsResponseBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:GetFileObjectDetailsResponseBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <xsd:complexType name="SearchFileObjectsResponseType">
                <xsd:complexContent>
                    <xsd:extension base="tns:WsResponseBase">
                        <xsd:sequence>
                            <xsd:element name="body" type="tns:SearchFileObjectsResponseBody"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>

            <!-- ====================================================== -->
            <!--                     SIMPLE TYPES                -->
            <!-- ====================================================== -->

            <xsd:simpleType name="PermissionList">
                <xsd:list itemType="xsd:string"/>
            </xsd:simpleType>

            <xsd:simpleType name="FileObjectTypeEnumType">
                <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="DIRECTORY"/>
                    <xsd:enumeration value="FILE"/>
                    <xsd:enumeration value="LINK"/>
                </xsd:restriction>
            </xsd:simpleType>

            <xsd:simpleType name="FilterFieldEnumType">
                <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="NAME"/>
                    <xsd:enumeration value="TYPE"/>
                    <xsd:enumeration value="APPLICATION"/>
                    <xsd:enumeration value="PARENT"/>
                    <xsd:enumeration value="STATUS"/>
                    <xsd:enumeration value="CREATION_DATETIME"/>
                    <xsd:enumeration value="MODIFICATION_DATETIME"/>
                    <xsd:enumeration value="DELETION_DATETIME"/>
                </xsd:restriction>
            </xsd:simpleType>

            <xsd:simpleType name="SortFieldEnumType">
                <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="NAME"/>
                    <xsd:enumeration value="TYPE"/>
                    <xsd:enumeration value="CREATION_DATETIME"/>
                    <xsd:enumeration value="MODIFICATION_DATETIME"/>
                    <xsd:enumeration value="DELETION_DATETIME"/>
                </xsd:restriction>
            </xsd:simpleType>

            <xsd:simpleType name="FileObjectStatusEnumType">
                <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="ACTIVE"/>
                    <xsd:enumeration value="REMOVED"/>
                </xsd:restriction>
            </xsd:simpleType>

            <!-- ====================================================== -->
            <!--                     ELEMENT DECLARATIONS                -->
            <!-- ====================================================== -->

            <xsd:element name="CreateDirRequest" type="tns:CreateDirRequestType"/>
            <xsd:element name="CreateDirResponse" type="tns:CreateDirResponseType"/>

            <xsd:element name="CreateFileRequest" type="tns:CreateFileRequestType"/>
            <xsd:element name="CreateFileResponse" type="tns:CreateFileResponseType"/>

            <xsd:element name="RenameFileObjectRequest" type="tns:RenameFileObjectRequestType"/>
            <xsd:element name="RenameFileObjectResponse" type="tns:RenameFileObjectResponseType"/>

            <xsd:element name="MoveFileObjectRequest" type="tns:MoveFileObjectRequestType"/>
            <xsd:element name="MoveFileObjectResponse" type="tns:MoveFileObjectResponseType"/>

            <xsd:element name="DeleteFileObjectRequest" type="tns:DeleteFileObjectRequestType"/>
            <xsd:element name="DeleteFileObjectResponse" type="tns:DeleteFileObjectResponseType"/>

            <xsd:element name="GetFileObjectDetailsRequest" type="tns:GetFileObjectDetailsRequestType"/>
            <xsd:element name="GetFileObjectDetailsResponse" type="tns:GetFileObjectDetailsResponseType"/>

            <xsd:element name="SearchFileObjectsRequest" type="tns:SearchFileObjectsRequestType"/>
            <xsd:element name="SearchFileObjectsResponse" type="tns:SearchFileObjectsResponseType"/>

        </xsd:schema>
    </types>

    <!-- ====================================================== -->
    <!--                        MESSAGES                        -->
    <!-- ====================================================== -->

    <message name="CreateDirRequestMessage">
        <part name="parameters" element="tns:CreateDirRequest"/>
    </message>

    <message name="CreateDirResponseMessage">
        <part name="parameters" element="tns:CreateDirResponse"/>
    </message>


    <message name="CreateFileRequestMessage">
        <part name="parameters" element="tns:CreateFileRequest"/>
    </message>

    <message name="CreateFileResponseMessage">
        <part name="parameters" element="tns:CreateFileResponse"/>
    </message>


    <message name="RenameFileObjectRequestMessage">
        <part name="parameters" element="tns:RenameFileObjectRequest"/>
    </message>

    <message name="RenameFileObjectResponseMessage">
        <part name="parameters" element="tns:RenameFileObjectResponse"/>
    </message>


    <message name="MoveFileObjectRequestMessage">
        <part name="parameters" element="tns:MoveFileObjectRequest"/>
    </message>

    <message name="MoveFileObjectResponseMessage">
        <part name="parameters" element="tns:MoveFileObjectResponse"/>
    </message>


    <message name="DeleteFileObjectRequestMessage">
        <part name="parameters" element="tns:DeleteFileObjectRequest"/>
    </message>

    <message name="DeleteFileObjectResponseMessage">
        <part name="parameters" element="tns:DeleteFileObjectResponse"/>
    </message>


    <message name="GetFileObjectDetailsRequestMessage">
        <part name="parameters" element="tns:GetFileObjectDetailsRequest"/>
    </message>

    <message name="GetFileObjectDetailsResponseMessage">
        <part name="parameters" element="tns:GetFileObjectDetailsResponse"/>
    </message>


    <message name="SearchFileObjectsRequestMessage">
        <part name="parameters" element="tns:SearchFileObjectsRequest"/>
    </message>

    <message name="SearchFileObjectsResponseMessage">
        <part name="parameters" element="tns:SearchFileObjectsResponse"/>
    </message>

    <!-- ====================================================== -->
    <!--                        PORT TYPE                       -->
    <!-- ====================================================== -->

    <portType name="FileObjectPortType">

        <operation name="CreateDir">
            <input message="tns:CreateDirRequestMessage"/>
            <output message="tns:CreateDirResponseMessage"/>
        </operation>

        <operation name="CreateFile">
            <input message="tns:CreateFileRequestMessage"/>
            <output message="tns:CreateFileResponseMessage"/>
        </operation>

        <operation name="RenameFileObject">
            <input message="tns:RenameFileObjectRequestMessage"/>
            <output message="tns:RenameFileObjectResponseMessage"/>
        </operation>

        <operation name="MoveFileObject">
            <input message="tns:MoveFileObjectRequestMessage"/>
            <output message="tns:MoveFileObjectResponseMessage"/>
        </operation>

        <operation name="DeleteFileObject">
            <input message="tns:DeleteFileObjectRequestMessage"/>
            <output message="tns:DeleteFileObjectResponseMessage"/>
        </operation>

        <operation name="GetFileObjectDetails">
            <input message="tns:GetFileObjectDetailsRequestMessage"/>
            <output message="tns:GetFileObjectDetailsResponseMessage"/>
        </operation>

        <operation name="SearchFileObjects">
            <input message="tns:SearchFileObjectsRequestMessage"/>
            <output message="tns:SearchFileObjectsResponseMessage"/>
        </operation>

    </portType>

    <!-- ====================================================== -->
    <!--                         BINDING                         -->
    <!-- ====================================================== -->

    <binding name="FileObjectBinding" type="tns:FileObjectPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

        <operation name="CreateDir">
            <soap:operation soapAction="http://example.com/fileobject/CreateDir"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="CreateFile">
            <soap:operation soapAction="http://example.com/fileobject/CreateFile"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="RenameFileObject">
            <soap:operation soapAction="http://example.com/fileobject/RenameFileObject"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="MoveFileObject">
            <soap:operation soapAction="http://example.com/fileobject/MoveFileObject"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="DeleteFileObject">
            <soap:operation soapAction="http://example.com/fileobject/DeleteFileObject"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="GetFileObjectDetails">
            <soap:operation soapAction="http://example.com/fileobject/GetFileObjectDetails"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="SearchFileObjects">
            <soap:operation soapAction="http://example.com/fileobject/SearchFileObjects"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

    </binding>

    <!-- ====================================================== -->
    <!--                         SERVICE                         -->
    <!-- ====================================================== -->

    <service name="FileObjectService">
        <port name="FileObjectPort" binding="tns:FileObjectBinding">
            <soap:address location="http://example.com/fileobject/service"/>
        </port>
    </service>

</definitions>