<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://example.com/vfs"
            xmlns:Q1="http://example.com/vfs" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:complexType name="MessageHeader">
        <xsd:sequence>
            <xsd:element maxOccurs="1" minOccurs="0" name="applicationId"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="MessageBase">
        <xsd:sequence>
            <xsd:element maxOccurs="1" minOccurs="0" name="header" type="Q1:MessageHeader"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="RegisterVfsClientDgBody">
        <xsd:sequence>
            <xsd:element name="UserData">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="id" type="xsd:string"/>
                        <xsd:element name="name" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="RegisterVfsClientDg">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="Q1:MessageBase">
                    <xsd:sequence>
                        <xsd:element name="body" type="Q1:RegisterVfsClientDgBody" />
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:complexType name="PublishUserReigstrationDgBody">
        <xsd:sequence>
            <xsd:element name="ApplicationData">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="id" type="xsd:string"/>
                        <xsd:element name="name" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="PublishUserReigstrationDg">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="Q1:MessageBase">
                    <xsd:sequence>
                        <xsd:element name="body" type="Q1:PublishUserReigstrationDgBody" />
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:complexType name="DeletedFileObjectDTO">
        <xsd:sequence>
            <xsd:element name="id" type="xsd:string" />
            <xsd:element name="creatorApplicationId" type="xsd:string" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="PublishFileObjectDeletionDgBody">
        <xsd:sequence>
            <xsd:element name="FileObjects">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="deletedFileObject" type="Q1:DeletedFileObjectDTO"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="PublishFileObjectDeletionDg">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="Q1:MessageBase">
                    <xsd:sequence>
                        <xsd:element name="body" type="Q1:PublishFileObjectDeletionDgBody" />
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>

